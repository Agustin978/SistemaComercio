APP_NAME="Sistema Comercio"
APP_ENV=testing
APP_KEY=base64:EdI7TjxkgHIq6qsXRNLQK9nvLTRwIXBNBBLzZlq0N70=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Copiar a .env.testing (ignorado por git) y ajustar DB_USERNAME/DB_PASSWORD al Postgres local.
# CI usa este archivo tal cual contra un servicio Postgres con auth "trust".
# La base sistema_comercio_testing hay que crearla una vez: CREATE DATABASE sistema_comercio_testing;
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sistema_comercio_testing
DB_USERNAME=sistema_comercio
DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
